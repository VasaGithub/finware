{
  "name": "finware",
  "version": "0.1.0",
  "private": true,
  "description": "Personal finance tracker with AI categorization",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter './apps/*' build",
    "test": "pnpm --filter './apps/*' test",
    "lint": "pnpm --filter './apps/*' lint",
    "db:migrate": "pnpm --filter @finware/api db:migrate",
    "db:studio": "pnpm --filter @finware/api db:studio",
    "db:generate": "pnpm --filter @finware/api db:generate"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
